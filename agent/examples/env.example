# .env for the SyncHub worker: the address, the token and (for SMB) the login for the Unraid shares.
SYNCHUB_URL=http://192.168.1.20:5001
SYNCHUB_TOKEN=sw_replace-with-the-token-from-synchub
SYNCHUB_NAME=encoder-1
SYNCHUB_WORK=/work
# A big local disk for job folders and the original files kept for the retention period:
WORK_DIR=./work

# The Unraid user that may read and write the shares. These stay on this PC; SyncHub never stores them.
# In the password write $ as $$ and a comma as two commas. Keep this file private:  chmod 600 .env
SMB_USER=
SMB_PASSWORD=
