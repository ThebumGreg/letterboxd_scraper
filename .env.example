# Copy to .env (next to docker-compose.yml) and edit. Every line is optional.
TZ=Europe/London
# Unraid's nobody:users. On a normal Linux machine: your own, from `id -u` and `id -g`.
PUID=99
PGID=100
# Where the database and everything else lives. On Unraid use the cache/pool path, not /mnt/user:
SYNCHUB_DATA=/mnt/cache/appdata/synchub
# The port on the host:
SYNCHUB_PORT=5001
# SYNCHUB_PORT_80=80        # with docker-compose.port80.yml: the host port that reaches the container's port 80
# Optional login for the whole site: any long random text. Leave empty for no login.
SYNCHUB_ACCESS_TOKEN=
